"""Type stubs for the native (PyO3) module."""
from collections.abc import Callable
from typing import Any

import numpy as np
from numpy.typing import NDArray

# pylint: disable=unused-argument

def _read_pixie_raw(path: str) -> tuple[NDArray[np.int64], dict[str, NDArray[np.float64]]]: ...
def _write_pixie_raw(
    path: str,
    series_names: list[str],
    timestamps_unix_seconds: NDArray[np.int64],
    values_per_series: list[NDArray[np.float64]],
    use_64bit_precision: bool,
) -> None: ...
def _simulate_from_file(
    model_path: str,
    output_path: str | None = None,
    mass_balance_path: str | None = None,
) -> None: ...
def _optimise_from_file(
    config_path: str,
    model_path: str | None = None,
    save_model_path: str | None = None,
    progress: Callable[[dict[str, Any]], Any] | None = None,
) -> dict[str, Any]: ...

class KalixError(Exception): ...
class ModelParseError(KalixError): ...
class ModelValidationError(KalixError): ...
class SimulationError(KalixError): ...
class KalixKeyError(KalixError, KeyError): ...
class KalixRuntimeError(KalixError, RuntimeError): ...

class _PatchMode:
    Merge: "_PatchMode"
    Replace: "_PatchMode"
    Delete: "_PatchMode"
    DeleteMissingOk: "_PatchMode"

class _Model:
    def __init__(self) -> None: ...
    def copy(self) -> "_Model": ...
    def _from_file(self, model_path: str) -> "_Model": ...
    def _from_model_string(self, model_string: str) -> "_Model": ...
    def _run(self, progress: Callable[[int, int], Any] | None = None) -> "_Model": ...
    def _patch(self, patch_string: str, mode: _PatchMode) -> "_Model": ...
    def _get_outputs(
        self, names: list[str] | None = None, missing_ok: bool = False
    ) -> tuple[int, int, int, list[tuple[str, NDArray[np.float64]]]]: ...
    def _get_mass_balance(self) -> tuple[list[str], list[str], list[float]]: ...
    def _sections(self) -> list[str]: ...
    def _get_section(self, section_name: str) -> dict[str, str]: ...
    def _has_section(self, section_name: str) -> bool: ...
    def _get_property(self, section_name: str, property_name: str) -> str: ...
    def _get_property_by_designation(self, property_designation: str) -> str: ...
    def _to_string(self) -> str: ...
    def _save(self, filename: str) -> "_Model": ...
    def _set_input(
        self,
        alias: str,
        column_names: list[str],
        timestamps_unix_seconds: NDArray[np.int64],
        values_per_column: list[NDArray[np.float64]],
    ) -> "_Model": ...
